{
  "manifest_version": 3,
  "name": "CodeSense AI - Real-Time Coding Assistant",
  "version": "1.0.0",
  "description": "Detect Mistakes While You Code. Don't Wait to Run. Real-time red underline & intelligent voice alerts.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://*.geeksforgeeks.org/*",
    "https://*.hackerrank.com/*",
    "https://*.codechef.com/*",
    "https://*.codeforces.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "CodeSense AI Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.hackerrank.com/*",
        "https://*.codechef.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js", "icons/*"],
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.hackerrank.com/*",
        "https://*.codechef.com/*",
        "https://*.codeforces.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
